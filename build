#!/usr/bin/env bash
set -euo pipefail

BIN_NAME="docker-proxy"
RELEASE_DIR="release"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

log()  { echo -e "${GREEN}$*${NC}"; }
warn() { echo -e "${YELLOW}$*${NC}"; }
err()  { echo -e "${RED}$*${NC}" >&2; }

check_deps() {
    local missing=()

    if ! command -v cargo &>/dev/null; then
        missing+=("cargo (rust)")
    fi

    if ! command -v cargo-zigbuild &>/dev/null; then
        err "cargo-zigbuild is not installed."
        err "  Install: cargo install cargo-zigbuild"
        exit 1
    fi

    if ! command -v zig &>/dev/null; then
        err "zig is not installed."
        err "  macOS:  brew install zig"
        err "  Linux:  snap install zig --classic"
        err "         or download from https://ziglang.org/download/"
        exit 1
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        err "Missing dependencies: ${missing[*]}"
        exit 1
    fi
}

add_targets() {
    log "Adding cross-compilation targets ..."
    rustup target add \
        x86_64-unknown-linux-musl \
        aarch64-unknown-linux-musl \
        x86_64-apple-darwin \
        2>/dev/null || true
}

build_target() {
    local target="$1"
    local label="$2"
    local output="$3"

    log "Building ${label} (${target}) ..."
    if [[ "$target" == *apple* ]]; then
        cargo build --release --target "$target" 2>&1 | tail -1
    else
        cargo zigbuild --release --target "$target" 2>&1 | tail -1
    fi

    local src="target/${target}/release/${BIN_NAME}"
    if [ ! -f "$src" ]; then
        err "Build failed for ${target} (binary not found at ${src})"
        return 1
    fi

    cp "$src" "${RELEASE_DIR}/${output}"
    log "  -> ${RELEASE_DIR}/${output}"
}

main() {
    echo ""
    echo -e "  ${BOLD}Docker Proxy - Build Releases${NC}"
    echo ""

    check_deps
    add_targets

    rm -rf "$RELEASE_DIR"
    mkdir -p "$RELEASE_DIR"

    # Linux (statically linked via musl + zigbuild)
    build_target "x86_64-unknown-linux-musl"   "Linux x86_64"    "${BIN_NAME}-linux-x86_64"
    build_target "aarch64-unknown-linux-musl"  "Linux aarch64"   "${BIN_NAME}-linux-aarch64"

    # macOS (native or zigbuild)
    build_target "x86_64-apple-darwin"         "macOS x86_64"    "${BIN_NAME}-macos-x86_64"

    local native_arch
    native_arch=$(uname -m)
    if [ "$native_arch" = "arm64" ]; then
        build_target "aarch64-apple-darwin"    "macOS arm64"     "${BIN_NAME}-macos-arm64"
    elif [ "$native_arch" = "x86_64" ]; then
        build_target "aarch64-apple-darwin"    "macOS arm64 (cross)" "${BIN_NAME}-macos-arm64"
    else
        err "Unsupported macOS architecture: $native_arch"
        exit 1
    fi

    echo ""
    log "Generating checksums ..."
    (
        cd "$RELEASE_DIR"
        sha256sum ${BIN_NAME}-* > SHA256SUMS
    )
    log "  -> ${RELEASE_DIR}/SHA256SUMS"

    echo ""
    log "All builds complete."
    echo ""
    echo "  Output: ${RELEASE_DIR}/"
    ls -lh "$RELEASE_DIR/"
    echo ""
    echo -e "  ${BOLD}Next: run ./update to create a GitHub release${NC}"
    echo ""
}

main
